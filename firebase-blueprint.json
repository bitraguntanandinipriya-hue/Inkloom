{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII author workspace display profile stored at /users/{userId}",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "themePreference": {
          "type": "string",
          "enum": ["system", "light", "dark"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "displayName", "themePreference", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "PII and private author studio preferences isolated under /users/{userId}/private/info",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "authMethod": {
          "type": "string",
          "enum": ["google", "email"]
        },
        "editorPrefs": {
          "type": "object"
        },
        "aiPrefs": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "email", "authMethod", "editorPrefs", "aiPrefs", "createdAt", "updatedAt"]
    },
    "Novel": {
      "title": "Novel",
