  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Owner-isolated non-PII author display profile"
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII and studio preferences (infoId = 'info')"
    },
    "/novels/{novelId}": {
      "schema": { "$ref": "#/entities/Novel" },
      "description": "Top-level novel collection owned by an authenticated author"
    },
    "/novels/{novelId}/characters/{characterId}": {
      "schema": { "$ref": "#/entities/Character" },
      "description": "Lead and supporting characters belonging to a novel"
    },
    "/novels/{novelId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Novel manuscript chapters and trash state"
    },
    "/novels/{novelId}/chapters/{chapterId}/versions/{versionId}": {
      "schema": { "$ref": "#/entities/ChapterVersion" },
      "description": "Immutable chapter version snapshots"
    },
    "/novels/{novelId}/canonFacts/{canonId}": {
      "schema": { "$ref": "#/entities/CanonFact" },
      "description": "Author-owned canon facts and pending proposals"
    },
    "/novels/{novelId}/summaries/{summaryId}": {
      "schema": { "$ref": "#/entities/ChapterSummary" },
      "description": "Chapter continuity summaries and extracted elements"
    },
    "/novels/{novelId}/stateProposals/{proposalId}": {
      "schema": { "$ref": "#/entities/CharacterStateProposal" },
      "description": "Character status/location change proposals awaiting approval"
    },
    "/novels/{novelId}/scratchpadNotes/{noteId}": {
      "schema": { "$ref": "#/entities/ScratchpadNote" },
      "description": "Private non-canon brainstorming notes"
    },
    "/novels/{novelId}/images/{imageId}": {
      "schema": { "$ref": "#/entities/ImageMetadata" },
      "description": "Author-uploaded image metadata records linked to object storage"
    }
  }
}
