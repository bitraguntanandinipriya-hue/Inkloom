          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "authorName": {
          "type": "string",
          "maxLength": 120
        },
        "genre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "synopsis": {
          "type": "string",
          "maxLength": 5000
        },
        "coverImageId": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed", "trashed"]
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "trashedAt": {
          "type": "string",
          "format": "date-time"
        },
        "storyDna": {
          "type": "object"
        },
        "chapterCount": {
          "type": "integer"
        },
        "totalWordCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "authorName", "genre", "synopsis", "status", "storyDna", "createdAt", "updatedAt"]
    },
