      "required": ["id", "novelId", "userId", "roleType", "name", "status", "sortOrder", "createdAt", "updatedAt"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Novel chapter manuscript with anchors, status, word count, and version metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
