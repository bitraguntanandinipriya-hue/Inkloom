          "maxLength": 2000
        },
        "physicalAppearance": {
          "type": "string",
          "maxLength": 2000
        },
        "backstory": {
          "type": "string",
          "maxLength": 4000
        },
        "characterDevelopment": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Injured", "Missing", "Estranged", "Deceased", "Custom"]
