# GEMINI_API_KEY: Required for server-side managed Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Optional secret for signing session tokens (persisted safely in ./data if omitted).
JWT_SECRET=""

# CREDENTIAL_ENCRYPTION_SECRET: Optional 32-byte key for encrypting author API keys at rest.
CREDENTIAL_ENCRYPTION_SECRET=""

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Client ID for Google Sign-In.
VITE_GOOGLE_CLIENT_ID=""
